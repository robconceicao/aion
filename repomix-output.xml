                    const SizedBox(height: 14),
                    _buildTwoColumnSection(context),
                    const SizedBox(height: 14),
                    _buildSymbolsSection(),
                    const SizedBox(height: 14),
                    _buildHeroJourneySection(),
                    const SizedBox(height: 14),
